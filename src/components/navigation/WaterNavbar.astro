---
// Encabezado del visualizador: identidad, instituciones y texto explicativo.
// Sin animaciones: el encabezado debe ser sobrio y no competir con el mapa.
---

<header
  class="relative z-[10001] h-16 shrink-0 bg-gradient-to-b from-cyan-700 to-cyan-900 text-white flex items-center justify-between gap-3 px-4 sm:px-6 shadow-md"
>
  <div class="leading-tight min-w-0">
    <h1 class="text-lg sm:text-xl font-bold truncate">Aguas Transparentes</h1>
    <p class="text-[11px] sm:text-xs text-cyan-100 truncate">
      Visualizador de Extracciones Efectivas
    </p>
  </div>

  <div class="flex items-center gap-3 shrink-0">
    <!--
      Logos institucionales. Los archivos viven en public/logos/.
      Usar versiones monocromas claras: el encabezado es de fondo oscuro.
      Si un archivo falta, el navegador muestra el texto alternativo.
    -->
    <div class="hidden sm:flex items-center gap-4">
      <img
        src="/logos/dga.svg"
        alt="Dirección General de Aguas (DGA)"
        class="h-9 w-auto max-w-[9rem] object-contain"
        loading="eager"
      />
      <span class="w-px h-8 bg-white/25" aria-hidden="true"></span>
      <img
        src="/logos/duoc.svg"
        alt="Duoc UC"
        class="h-9 w-auto max-w-[9rem] object-contain"
        loading="eager"
      />
    </div>

    <!-- Texto explicativo: origen del dato y responsabilidad de los titulares -->
    <details class="relative group">
      <summary
        class="list-none cursor-pointer w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 border border-white/30 flex items-center justify-center transition-colors"
        aria-label="Información sobre el visualizador y el origen de los datos"
        title="Información sobre el visualizador y el origen de los datos"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-2 w-[min(92vw,26rem)] bg-white text-gray-700 text-xs leading-relaxed rounded-lg shadow-xl border border-gray-200 p-4 space-y-2"
      >
        <p>
          Los datos publicados provienen de las <strong>declaraciones de extracciones efectivas</strong>
          que los titulares de derechos de aprovechamiento de aguas informan a la
          <strong>Dirección General de Aguas (DGA)</strong>.
        </p>
        <p>
          La <strong>veracidad y oportunidad</strong> de la información declarada es
          <strong>responsabilidad de cada titular</strong>. La DGA la publica con fines
          informativos y de transparencia, sin que ello implique validación de su contenido.
        </p>
        <p class="pt-1 border-t border-gray-100 text-gray-500">
          Visualizador desarrollado por <strong>Duoc UC</strong> en conjunto con la
          <strong>Dirección General de Aguas</strong>.
        </p>
        <p class="md:hidden text-gray-500">DGA · Duoc UC</p>
      </div>
    </details>
  </div>
</header>

<script>
  // Mientras no estén los archivos en public/logos/, mostrar el nombre de la
  // institución en vez del ícono de imagen rota.
  const aTexto = (img) => {
    const texto = document.createElement('span');
    texto.className = 'text-[11px] sm:text-xs text-cyan-100 leading-tight whitespace-nowrap';
    texto.textContent = img.getAttribute('alt') ?? '';
    img.replaceWith(texto);
  };

  document.querySelectorAll('header img[alt]').forEach((img) => {
    img.addEventListener('error', () => aTexto(img));
    // La imagen puede haber fallado antes de que este script corriera
    if (img.complete && img.naturalWidth === 0) aTexto(img);
  });
</script>
